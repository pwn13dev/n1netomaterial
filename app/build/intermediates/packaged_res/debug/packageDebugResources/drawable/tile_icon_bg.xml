<?xml version="1.0" encoding="utf-8"?>
<!-- Circular icon backdrop: solid container when idle, accent ring when focused (API 17+ safe) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/surface_high_dark" />
            <stroke android:width="3dp" android:color="@color/accent_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/surface_high_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_container_dark" />
            <stroke android:width="1dp" android:color="@color/outline_dark" />
        </shape>
    </item>
</selector>
