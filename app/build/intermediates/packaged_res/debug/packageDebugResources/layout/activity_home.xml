<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: clock header + rows of Material app tiles -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Wallpaper layer (swappable from settings) -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin">

        <!-- Header: clock / date / launcher name -->
        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/clock"
                style="@style/Text.N1.Clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/clock_default" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/clock"
                android:layout_alignStart="@id/clock"
                android:textColor="@color/on_surface_dim_dark"
                android:textSize="14sp"
                android:text="" />

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tile_icon_bg"
                android:contentDescription="@string/action_settings"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_settings" />
        </RelativeLayout>

        <!-- Rows container: title + horizontal RecyclerView per row -->
        <LinearLayout
            android:id="@+id/rows_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- Bottom hint pill -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/tile_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/hint_nav"
        android:textColor="@color/on_surface_dim_dark"
        android:textSize="12sp" />

</FrameLayout>
