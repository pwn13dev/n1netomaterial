<?xml version="1.0" encoding="utf-8"?>
<!-- Tile card background: subtle lift + accent border on focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@color/surface_high_dark" />
            <stroke android:width="2dp" android:color="@color/accent_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@color/surface_high_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
