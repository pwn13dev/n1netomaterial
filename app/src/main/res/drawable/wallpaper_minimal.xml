<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal Lines wallpaper: thin accent rules, dimension-based insets (pre-API21 safe) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/background_dark" />
    <item android:top="140dp" android:left="-40dp" android:right="520dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <gradient android:startColor="#339A82FF" android:centerColor="#669A82FF"
                android:endColor="#00000000" android:angle="0" />
        </shape>
    </item>
    <item android:top="300dp" android:left="300dp" android:right="-60dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <gradient android:startColor="#00000000" android:centerColor="#5500BFA5"
                android:endColor="#3300BFA5" android:angle="0" />
        </shape>
    </item>
</layer-list>
